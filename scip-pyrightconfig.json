{
  "include": [
    "app.py",
    "config.py",
    "core",
    "data",
    "web",
    "tests",
    "tools",
    "scripts",
    "desktop"
  ],
  "exclude": [
    "**/node_modules",
    "**/.*",
    "**/__pycache__",
    ".git",
    ".pytest_cache",
    ".ruff_cache",
    ".venv",
    "assets",
    "audit",
    "backups",
    "build",
    "dist",
    "evidence",
    "installer",
    "logs",
    "templates_excel",
    "validate_dist_exe.py"
  ],
  "pythonVersion": "3.8",
  "typeCheckingMode": "basic",
  "venvPath": ".",
  "venv": ".venv",
  "executionEnvironments": [
    {
      "root": ".",
      "extraPaths": [
        ".",
        ".venv/Lib/site-packages"
      ]
    }
  ]
}
